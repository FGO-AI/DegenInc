{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "degen-inc",

  // Entry point emitted by `opennextjs-cloudflare build`. Do not point this at
  // src/ — the adapter compiles the Next build into this worker.
  "main": ".open-next/worker.js",

  // Matches the workerd bundled with the installed wrangler. A date newer than
  // the local runtime is rejected, so bump this and wrangler together.
  "compatibility_date": "2026-08-11",

  // nodejs_compat is mandatory: Next's server code uses Node built-ins.
  // global_fetch_strictly_public makes fetch() to our own hostname go out over
  // the public internet instead of looping back inside the worker, which is
  // what Next expects when it fetches its own routes.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static output (/_next/static, public/) served straight from the CDN
  // rather than through the worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "degen-inc",

      // PLACEHOLDER. Local development ignores this value entirely — miniflare
      // keys its SQLite file off database_name — but every remote command
      // (`--remote`, `deploy`) needs the real id.
      //
      //   npx wrangler d1 create degen-inc
      //
      // then paste the printed database_id here. Requires a Cloudflare login.
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE",

      // Plain .sql files applied by `wrangler d1 migrations apply`.
      // drizzle-kit generates into this same directory.
      "migrations_dir": "migrations"
    }
  ],

  // Product images, served by src/app/images/[...key]/route.ts. Reached in
  // code as env.PRODUCT_IMAGES; nothing reads the bucket name.
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",

      // UNCONFIRMED. This bucket has not been created. Local development does
      // not need it — miniflare keeps a simulated bucket on disk under
      // .wrangler/state — but every remote command (`deploy`) does:
      //
      //   npx wrangler r2 bucket create degen-inc-product-images
      //
      // Requires a Cloudflare login. If it is created under another name,
      // change this value to match; the binding name above stays as it is.
      "bucket_name": "degen-inc-product-images"
    }
  ]

  // Not configured yet — see README "Cloudflare deployment":
  //   images        — no next/image usage; product images are plain <img>
  //                   straight from R2, so Cloudflare Images is not needed yet
  //   kv_namespaces — optional session store
}
