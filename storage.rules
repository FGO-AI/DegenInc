rules_version = '2';

// Every direct client read and write is refused, for now.
//
// Product images are written only by the uploadProductImage Cloud Function and
// read only by the app's /images/... route, both through the Admin SDK, which
// these rules do not apply to. That route checks the product's visibility
// itself before it streams anything (src/app/images/[...key]/route.ts).
//
// The mobile apps will need to read images directly. When they do, the read
// rule goes here, and it must make the same visibility decision as
// firestore.rules and src/lib/visibility.ts: Storage rules can call
// firestore.get() to read the product an image path names
// (products/{productId}/{file}) and apply the same filing-status and
// publicAt / memberAccessAt test. Not built yet — until then, deny all.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
