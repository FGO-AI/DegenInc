# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template holds no secrets and should be committed.
!.env.example

# vercel
.vercel

# cloudflare / opennext
# Build output and wrangler's local state — both regenerated by `npm run preview`.
.open-next/
.wrangler/
# Local runtime secrets for `wrangler dev`. NEVER commit: this is where the
# service_role and Stripe keys live. The template beside it is safe.
.dev.vars
.dev.vars.*
!.dev.vars.example
# Generated by `npm run cf-typegen`, which the `prebuild` hook runs on every
# build — including in CI. Deliberately NOT committed: it is ~15k lines and
# goes stale the moment wrangler.jsonc changes. If a build fails with
# "Property 'DB' does not exist on type 'CloudflareEnv'", the fix is to run
# typegen, not to un-ignore this file.
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# github pages static preview (scripts/preview-export.mjs)
# Routes are copied here only for the duration of that build.
.preview-staged/
