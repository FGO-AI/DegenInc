# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase: emulator logs and the CLI's deploy cache
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/

# env files (can opt-in for committing if needed)
.env*
# ...but the template holds no secrets and should be committed.
!.env.example
# ...nor does the emulator config `next dev` loads: demo project ids only.
!.env.development

# vercel
.vercel

# service account keys: never in the repo. App Hosting supplies credentials,
# and locally the emulators need none.
*-service-account*.json
serviceAccount*.json

# typescript
*.tsbuildinfo
next-env.d.ts

# github pages static preview (scripts/preview-export.mjs)
# Routes are copied here only for the duration of that build.
.preview-staged/
