# Copy to .env.local and fill in. Both are safe to expose in client code —
# Row Level Security is what protects the data.
#
# Never put the service_role / secret key in a NEXT_PUBLIC_ variable: it
# bypasses RLS completely and would be readable by every visitor.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
