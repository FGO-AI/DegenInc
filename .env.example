# ---------------------------------------------------------------------------
# BUILD-TIME, PUBLIC. Copy to .env.local for local dev.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle when the app is
# built, so they must be present in the BUILD environment — not in Workers
# runtime secrets. Setting them with `wrangler secret put` does nothing: the
# bundle was already compiled without them.
#
#   local        .env.local (this file, copied)
#   Workers CI   Workers Builds -> Settings -> Variables (build variables)
#
# The database needs nothing here. D1 is a Worker binding (`DB` in
# wrangler.jsonc), not a connection string, so there is no public database
# credential to expose in the first place.

# Public site origin, used for auth callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turnstile widget key. Public by design; the matching secret is a runtime
# secret. Unused until the open call form is wired up.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ---------------------------------------------------------------------------
# RUNTIME, SECRET. These do NOT belong in this file.
# ---------------------------------------------------------------------------
# Server-only values are read at request time, never inlined, and must never
# carry a NEXT_PUBLIC_ prefix — that would ship them to every visitor.
#
#   local        .dev.vars  (gitignored; see .dev.vars.example)
#   production   wrangler secret put <NAME>
#
#   BETTER_AUTH_SECRET
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   TURNSTILE_SECRET_KEY
