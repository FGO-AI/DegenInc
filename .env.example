# ---------------------------------------------------------------------------
# BUILD-TIME, PUBLIC. Copy to .env.local for local dev.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle when the app is
# built, so they must be present in the BUILD environment — not in Workers
# runtime secrets. Setting them with `wrangler secret put` does nothing: the
# bundle was already compiled without them.
#
#   local        .env.local (this file, copied)
#   Workers CI   Workers Builds -> Settings -> Variables (build variables)
#
# Both are safe to expose. Row Level Security in Postgres is the actual
# security boundary; the anon key is designed to ship in client code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# RUNTIME, SECRET. These do NOT belong in this file.
# ---------------------------------------------------------------------------
# Server-only values are read at request time, never inlined, and must never
# carry a NEXT_PUBLIC_ prefix — that would ship them to every visitor's
# browser. The service_role key in particular bypasses RLS completely.
#
#   local        .dev.vars  (gitignored; see .dev.vars.example)
#   production   wrangler secret put <NAME>
#
# Currently unused — listed here so the split is documented before the
# backend work starts:
#
#   SUPABASE_SERVICE_ROLE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   TURNSTILE_SECRET_KEY
#
# The Turnstile *site* key is public and belongs in the build section above as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY when the open call form is wired up.
