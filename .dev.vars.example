# Copy to .dev.vars for local `wrangler dev` / `npm run preview`.
# .dev.vars is gitignored. These are runtime secrets: read on the server per
# request, never inlined into the client bundle.
#
# In production set each one with:
#   wrangler secret put BETTER_AUTH_SECRET
# or in the dashboard under Workers -> Settings -> Variables and Secrets.
#
# Do NOT put these in Workers Builds build variables. Those exist to feed the
# BUILD (that is where NEXT_PUBLIC_* belong, see .env.example); they are the
# wrong place for a value that must only ever be read on the server at request
# time.
#
# Note there is no database credential here. D1 is a binding declared in
# wrangler.jsonc, so there is no connection string and no public endpoint.

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Stripe. On Workers, initialize with Stripe.createFetchHttpClient() and verify
# webhooks with constructEventAsync + createSubtleCryptoProvider().
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Turnstile server-side verification for the open call form.
# The matching site key is public and goes in the build env instead.
TURNSTILE_SECRET_KEY=
