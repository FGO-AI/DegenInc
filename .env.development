# Loaded by `next dev` only. Local development runs against the Firebase
# emulators (`firebase emulators:start --project demo-degen-inc`), never a real
# project, so nothing here is a secret: demo-* project ids cannot reach real
# services at all. Override anything in .env.local, which wins over this file.

# Browser SDK: the web app config, and the switch that points it at the
# emulators on the ports in firebase.json.
NEXT_PUBLIC_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"demo-key","authDomain":"demo-degen-inc.firebaseapp.com","projectId":"demo-degen-inc","storageBucket":"demo-degen-inc.appspot.com"}'

# Admin SDK, on the Next server: the project and bucket initializeApp() reads
# from FIREBASE_CONFIG, and the emulator hosts that redirect every call.
FIREBASE_CONFIG='{"projectId":"demo-degen-inc","storageBucket":"demo-degen-inc.appspot.com"}'
GCLOUD_PROJECT=demo-degen-inc
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
